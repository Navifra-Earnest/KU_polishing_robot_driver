<launch>
  <!-- 리프트 드라이버 (MDROBOT MD DC 모터, RS485 / COM1)
       입력: /lift/command(String up/down/stop), /lift/velocity_cmd(Int16)
       출력: /lift/position(Int32), /lift/status(String) -->
  <arg name="lift_params" default="$(find lift_driver)/config/lift_driver.yaml"/>
  <!-- 로봇 현장 보정값(오프셋). robot.launch 로 실행 시엔 거기서 로드하므로 기본 off.
       단독 실행 시 override 를 쓰려면 load_params:=true 로 실행. -->
  <arg name="param_file"  default="$(optenv HOME)/navifra/param.yaml"/>
  <arg name="load_params" default="false"/>

  <node pkg="lift_driver" type="lift_driver_node" name="lift_driver" output="screen">
    <rosparam command="load" file="$(arg lift_params)"/>
  </node>

  <!-- 현장 보정값 override: 노드 기본 config 뒤에 로드 → 같은 키를 덮어씀(win). -->
  <rosparam if="$(arg load_params)" command="load" file="$(arg param_file)"/>
</launch>
