[Unit]
Description=Navifra KU Polishing Robot ROS bringup (run_robot.sh)
# CAN(can0/can1)을 올리는 caninit.service 가 끝난 뒤 실행.
After=caninit.service network.target
Requires=caninit.service

[Service]
Type=simple
User=abc
Group=abc
Environment=HOME=/home/abc
WorkingDirectory=/home/abc/navifra
ExecStart=/home/abc/navifra/run_robot.sh
# roslaunch 는 SIGINT 로 노드들을 깔끔히 종료시킨다.
KillSignal=SIGINT
TimeoutStopSec=20
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
